# ============================================================
# LiveSession — Environment Variables
# ============================================================

# LiveKit Cloud project credentials
LIVEKIT_URL=w
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Port the Express token server listens on
PORT=3001

# Comma-separated list of origins allowed to call the API (CORS).
# In local dev this is typically the Vite dev server.
CLIENT_ORIGIN=http://localhost:5173